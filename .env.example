# CloudBase PostgreSQL shared cluster, accessed through server-only HTTPS SQL.
# Never prefix the API key with NEXT_PUBLIC_. DATABASE_URL is no longer used.
CLOUDBASE_ENV_ID=yueyong-photo-d6gm6308c8838e9e7
CLOUDBASE_API_KEY=
CLOUDBASE_REGION=ap-shanghai

# Qiniu Kodo photo storage
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_PUBLIC_URL=https://cdn.ytools.xyz

# Zhipu AI photo caption generation
ZHIPU_AI_API_KEY=
ZHIPU_PHOTO_MODEL=glm-5.3-flash

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
