# CloudBase MySQL (must be reachable from the Vercel runtime)
DATABASE_URL=mysql://photo_site_app:password@database-host:3306/database
DATABASE_POOL_SIZE=4

# Optional local CloudBase database migration tooling (do not add to Vercel)
CLOUDBASE_ENV_ID=ytools-d8gboj3ce7caccb14
CLOUDBASE_REGION=ap-shanghai

# Qiniu Kodo photo storage
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_PUBLIC_URL=https://cdn.ytools.xyz

# Zhipu AI photo caption generation
ZHIPU_AI_API_KEY=
ZHIPU_PHOTO_MODEL=glm-5.3-flash

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
